    {
      "package": "openai",
      "old_api": "openai.api_key",
      "new_api": "OpenAI(api_key=...)",
      "requires_instantiation": "Yes",
      "migartion_type": "client_migration",
      "migration_description": "API key configuration moved from module-level attribute to client instantiation parameter",
      "example_before": "openai.api_key = os.environ['OPENAI_API_KEY']",
      "example_after": "client = OpenAI(\n  api_key=os.environ['OPENAI_API_KEY'],\n)"
    },
    {
      "package": "openai",
      "old_api": "openai.Completion.create",
      "new_api": "client.completions.create",
      "requires_instantiation": "Yes",
      "migartion_type": "client_migration",
      "migration_description": "Completion API moved to client instance method",
      "example_before": "completion = openai.Completion.create(model='curie')",
      "example_after": "completion = client.completions.create(model='curie')"
    },
    {
      "package": "openai",
      "old_api": "openai.ChatCompletion.acreate",
      "new_api": "await client.chat.completions.create",
      "requires_instantiation": "Yes",
      "migartion_type": "client_migration",
      "migration_description": "Async chat completion API moved to async client instance method",
      "example_before": "completion = openai.ChatCompletion.acreate(model=\"gpt-3.5-turbo\", messages=[{\"role\": \"user\", \"content\": \"Hello world\"}])",
      "example_after": "client = AsyncOpenAI()\ncompletion = await client.chat.completions.create(model=\"gpt-3.5-turbo\", messages=[{\"role\": \"user\", \"content\": \"Hello world\"}])"
    },
